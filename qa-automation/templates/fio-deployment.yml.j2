apiVersion: apps/v1
kind: Deployment
metadata:
  name: fio-tenant
  namespace: {{ e2e_io_namespace }}
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: fio-tenant
  template:
    metadata:
      labels:
        app: fio-tenant
    spec:
      containers:
        - name: fio
          image: {{ e2e_fio_image }}
          command: [/bin/sh, -c]
          args:
            - |
              set -e
              echo 'Writing the student 6 GiB test dataset...'
              fio --name=layout --filename=/data/fio.dat --size=6G --bs=1M --rw=write \
                  --ioengine=libaio --direct=1 --iodepth=8 --output-format=json > /data/layout.json
              while true; do
                started=$(date +%s)
                fio --name=randread --filename=/data/fio.dat --size=6G --bs=4k --rw=randread \
                    --ioengine=libaio --direct=1 --iodepth=32 --time_based --runtime=15 \
                    --output-format=json --output=/data/fio-next.json
                { printf '{"started_epoch": %s, "fio": ' "$started"; cat /data/fio-next.json; printf '}\n'; } \
                    > /data/fio-sample.tmp
                mv /data/fio-sample.tmp /data/fio-sample.json
                cat /data/fio-sample.json
              done
          volumeMounts:
            - name: data
              mountPath: /data
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: fio-data
